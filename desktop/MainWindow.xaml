<Window x:Class="ImageStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ImageStudio"
        Title="Image Studio" Icon="Assets/ImageStudio.ico" Width="1480" Height="960" MinWidth="1140" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="WorkspaceTabs" Foreground="{StaticResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0" SelectionChanged="WorkspaceChanged">
      <TabControl.Template><ControlTemplate TargetType="TabControl">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="12,24,12,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="12,0,0,30"><Image Source="Assets/ImageStudio.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="Image Studio" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Your local creative studio" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="Workspace" Style="{StaticResource SectionLabel}" Margin="12,0,0,12"/><StackPanel IsItemsHost="True"/></StackPanel>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,18,0,0"><StackPanel><TextBlock Text="Made on your machine" FontSize="11" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Images and video, kept local" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/><TextBlock Text="Studio 2.2" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/></StackPanel></Border>
          </Grid></Border>
          <Grid Grid.Column="1" Margin="24,22,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,22"><Button Content="Output folder ↗" DockPanel.Dock="Right" Click="OpenFolder" VerticalAlignment="Center" Style="{StaticResource SubtleButton}"/><StackPanel><TextBlock Text="{Binding SelectedItem.(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedItem.Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,7,0,0"/></StackPanel></DockPanel>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" KeyboardNavigation.TabNavigation="Local"/>
          </Grid>
        </Grid>
      </ControlTemplate></TabControl.Template>
      <TabItem x:Name="StudioTab" Style="{StaticResource NavigationTabStyle}" AutomationProperties.Name="Still images" Tag="Describe an image. Choose your tools. Make it yours.">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" Margin="0,0,9,0"/><TextBlock Text="Still images"/></StackPanel></TabItem.Header>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="346"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelBorder}" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel x:Name="ControlsPanel">
                  <TextBlock Text="Image setup" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                  <Border Background="{StaticResource InputBrush}" CornerRadius="9" Padding="4" Margin="0,0,0,12">
                    <UniformGrid Columns="2"><RadioButton x:Name="CreateMode" Content="New image" AutomationProperties.Name="Create an image" Style="{StaticResource ModeRadioStyle}" GroupName="Mode" IsChecked="True" Checked="ModeChanged"/><RadioButton x:Name="EditMode" Content="Edit image" AutomationProperties.Name="Edit an image" Style="{StaticResource ModeRadioStyle}" GroupName="Mode" Checked="ModeChanged"/></UniformGrid>
                  </Border>
                  <Label Content="Image model" Target="{Binding ElementName=ImageModelBox}"/>
                  <ComboBox x:Name="ImageModelBox" DisplayMemberPath="Name" SelectionChanged="ImageModelChanged" AutomationProperties.Name="Image model" ToolTip="{Binding SelectedItem.Id, ElementName=ImageModelBox}"/>
                  <TextBlock x:Name="ImageModelHint" Text="Reading your model library…" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,16"/>
                  <Expander x:Name="SourcePanel" Header="Reference images" Margin="0,0,0,12"><StackPanel>
                    <DockPanel><Button DockPanel.Dock="Right" Content="Manage" Click="ManageReferences" Style="{StaticResource SubtleButton}" Padding="10,5" MinHeight="28"/><StackPanel><TextBlock Text="References" FontWeight="SemiBold"/><TextBlock x:Name="ReferenceSummary" Text="No reference images" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></DockPanel>
                    <CheckBox x:Name="IncludeReferences" Content="Use these references" IsChecked="True" Margin="0,6,0,0"/>
                  </StackPanel></Expander>
                  <Label x:Name="PromptLabel" Content="_Describe your image" Target="{Binding ElementName=PromptBox}"/>
                  <TextBox x:Name="PromptBox" Height="152" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Image description"/>
                  <TextBlock x:Name="PromptHint" Text="Describe the subject, setting, and style." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,10"/>
                  <StackPanel x:Name="ShapePanel"><Label Content="Image _shape" Target="{Binding ElementName=ShapeBox}"/><ComboBox x:Name="ShapeBox" SelectedIndex="0" AutomationProperties.Name="Image shape" Margin="0,0,0,14"><ComboBoxItem Content="Square · 1:1"/><ComboBoxItem Content="Landscape · 3:2"/><ComboBoxItem Content="Portrait · 2:3"/><ComboBoxItem Content="Widescreen · 16:9"/><ComboBoxItem Content="Tall · 9:16"/></ComboBox></StackPanel>
                  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><Label Content="Image si_ze" Target="{Binding ElementName=SizeBox}"/><ComboBox x:Name="SizeBox" SelectedIndex="0" AutomationProperties.Name="Image size"><ComboBoxItem Content="1 megapixel" ToolTip="Standard size"/><ComboBoxItem Content="2 megapixels" ToolTip="Large size"/><ComboBoxItem Content="4 megapixels" ToolTip="Extra large size"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="2"><Label Content="_Quality" Target="{Binding ElementName=QualityBox}"/><ComboBox x:Name="QualityBox" SelectedIndex="1" AutomationProperties.Name="Quality"><ComboBoxItem Content="Draft" ToolTip="12 steps"/><ComboBoxItem Content="Standard" ToolTip="25 steps"/><ComboBoxItem Content="Detailed" ToolTip="40 steps"/></ComboBox></StackPanel>
                  </Grid>
                  <local:LoraPicker x:Name="ImageLoras" Margin="0,0,0,18"/>
                  <CheckBox x:Name="TransparentBox" Content="Transparent background" Margin="0,0,0,18" ToolTip="Asks the model for transparency. Results are saved as PNG."/>
                  <Expander Header="Advanced settings"><StackPanel Margin="0,14,0,0"><Label Content="_Seed (optional)" Target="{Binding ElementName=SeedBox}"/><TextBox x:Name="SeedBox" AutomationProperties.Name="Seed"/><TextBlock Text="Leave blank for a new variation. Reuse a seed and settings to repeat an image." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,14"/><Label Content="_Things to avoid" Target="{Binding ElementName=NegativeBox}"/><TextBox x:Name="NegativeBox" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Things to avoid"/></StackPanel></Expander>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Margin="0,18,0,0"><Button x:Name="GenerateButton" Content="_Generate image" Style="{StaticResource PrimaryButton}" MinHeight="46" FontSize="14" Click="Generate"/><TextBlock Text="Ctrl + Enter · Saved automatically" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,13"><TextBlock Text="Image preview" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ImageInfo" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/></Grid>
            <Border Grid.Row="1" Background="{StaticResource CheckerboardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
              <Grid>
                <StackPanel x:Name="EmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                  <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,22"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEB9F;" FontSize="27" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                  <TextBlock Text="Your next image starts here" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Choose a model and describe what you see.&#x0a;We’ll take it from there." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,10,0,0" LineHeight="22"/>
                </StackPanel>
                <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="Generated image preview"><Image.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3"/></Image.Effect></Image>
              </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,12,0,22"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="AnimateButton" Content="Animate" Click="AnimatePreview" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="UseButton" Content="Edit this image" Click="UseAsSource" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Save _as…" Click="SaveAs" IsEnabled="False"/></StackPanel><WrapPanel><Button x:Name="OpenButton" Content="Open full size ↗" Style="{StaticResource SubtleButton}" Click="OpenImage" IsEnabled="False"/><Button x:Name="DeleteButton" Content="Delete image" Click="DeleteImage" Style="{StaticResource SubtleButton}" Foreground="#B4233A" IsEnabled="False" ToolTip="Move this image and its saved prompt details to the Recycle Bin"/></WrapPanel></DockPanel>
            <StackPanel Grid.Row="3"><DockPanel><Button Content="Refresh" Style="{StaticResource SubtleButton}" Click="RefreshGallery" DockPanel.Dock="Right" Padding="8,2" MinHeight="24" FontSize="11"/><TextBlock Text="Recent images" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="EmptyGallery" Text="Your saved images will appear here." Foreground="{StaticResource MutedBrush}" Margin="0,14,0,12" Visibility="Collapsed"/>
              <ListBox x:Name="Gallery" Height="112" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="GallerySelected" AutomationProperties.Name="Recent images"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="108" ToolTip="{Binding Path}"><Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="2"><Image Source="{Binding Thumbnail}" Height="68" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="10" Margin="2,6,2,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="VideoTab" Style="{StaticResource NavigationTabStyle}" AutomationProperties.Name="Videos" Tag="Create a clip from text or bring a still image to life.">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE714;" Margin="0,0,12,0"/><TextBlock Text="Videos"/></StackPanel></TabItem.Header>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="346"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelBorder}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel x:Name="VideoControls">
              <TextBlock Text="Video setup" Style="{StaticResource SectionLabel}"/>
              <Border Background="{StaticResource InputBrush}" CornerRadius="9" Padding="4" Margin="0,0,0,14"><UniformGrid Columns="2"><RadioButton x:Name="VideoTextMode" Content="From text" GroupName="VideoMode" IsChecked="True" Checked="VideoModeChanged"/><RadioButton x:Name="VideoImageMode" Content="From image" GroupName="VideoMode" Checked="VideoModeChanged"/></UniformGrid></Border>
              <Label Content="Video model" Target="{Binding ElementName=VideoModelBox}"/><ComboBox x:Name="VideoModelBox" DisplayMemberPath="Name" SelectionChanged="VideoModelChanged" AutomationProperties.Name="Video model" ToolTip="{Binding SelectedItem.Id, ElementName=VideoModelBox}"/>
              <TextBlock x:Name="VideoModelHint" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,16"/>
              <StackPanel x:Name="VideoSourcePanel" Visibility="Collapsed" Margin="0,0,0,14"><Label Content="First frame"/><Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="8"><DockPanel><Image x:Name="VideoSourcePreview" Width="60" Height="60" Stretch="Uniform" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="VideoSourceName" Text="Choose a starting image" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="165" FontSize="11"/><Button Content="Choose image…" Click="ChooseVideoSource" Style="{StaticResource SubtleButton}" Padding="0,4" HorizontalAlignment="Left"/></StackPanel></DockPanel></Border></StackPanel>
              <Label Content="Describe your video" Target="{Binding ElementName=VideoPromptBox}"/><TextBox x:Name="VideoPromptBox" Height="152" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Video description"/>
              <TextBlock Text="Describe the action, camera movement, and sound." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,16"/>
              <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><Label Content="Frame"/><ComboBox x:Name="VideoShapeBox" SelectedIndex="0" AutomationProperties.Name="Video shape"><ComboBoxItem Content="Landscape"/><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Square"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><Label Content="Duration"/><ComboBox x:Name="VideoDurationBox" SelectedIndex="0" AutomationProperties.Name="Video duration"><ComboBoxItem Content="3 seconds"/><ComboBoxItem Content="5 seconds"/><ComboBoxItem Content="10 seconds"/></ComboBox></StackPanel>
              </Grid>
              <TextBlock x:Name="VideoFormatHint" Text="768 × 512 · 24 fps · MP4 with audio" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,18"/>
              <local:LoraPicker x:Name="VideoLoras" Margin="0,0,0,16"/>
              <Expander Header="Advanced settings"><StackPanel><Label Content="Seed (optional)"/><TextBox x:Name="VideoSeedBox" AutomationProperties.Name="Video seed"/><StackPanel x:Name="VideoNegativePanel" Margin="0,12,0,0"><Label Content="Things to avoid"/><TextBox x:Name="VideoNegativeBox" TextWrapping="Wrap" AcceptsReturn="True" Height="64" AutomationProperties.Name="Video negative prompt"/></StackPanel></StackPanel></Expander>
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,18,0,0"><Button x:Name="GenerateVideoButton" Content="Generate video" Style="{StaticResource PrimaryButton}" Click="GenerateVideo" MinHeight="46" FontSize="14"/><TextBlock Text="Ctrl + Enter · Saved automatically" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>
          </Grid></Border>
          <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,13"><TextBlock Text="Video preview" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="VideoInfo" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></Grid>
            <Border Grid.Row="1" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12"><Grid>
              <StackPanel x:Name="EmptyVideo" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE714;" FontSize="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/><TextBlock Text="Set your ideas in motion." FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Start with a description or animate an image.&#x0a;Your finished clip will play here." TextAlignment="Center" Foreground="{StaticResource MutedBrush}" LineHeight="22" Margin="0,12,0,0"/></StackPanel>
              <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="VideoOpened" MediaEnded="VideoEnded" MediaFailed="VideoFailed" Volume="0.7"/>
            </Grid></Border>
            <Grid Grid.Row="2" Margin="0,12,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="VideoPlayButton" Content="Play" Click="ToggleVideo" IsEnabled="False" MinWidth="64"/>
              <Slider x:Name="VideoSeek" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SeekVideo" IsEnabled="False" VerticalAlignment="Center" Margin="14,0" AutomationProperties.Name="Video position"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="VideoOpenButton" Content="Open ↗" Click="OpenVideo" IsEnabled="False" Style="{StaticResource SubtleButton}"/><Button x:Name="VideoSaveButton" Content="Save as…" Click="SaveVideoAs" IsEnabled="False"/><Button x:Name="VideoDeleteButton" Content="Delete video" Click="DeleteVideo" IsEnabled="False" Style="{StaticResource SubtleButton}" Foreground="#B4233A"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="3"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Import…" Click="ImportVideos" Style="{StaticResource SubtleButton}" Padding="8,2" MinHeight="24" FontSize="11"/><Button Content="Refresh" Click="RefreshVideos" Style="{StaticResource SubtleButton}" Padding="8,2" MinHeight="24" FontSize="11"/></StackPanel><TextBlock Text="Recent videos" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/></DockPanel>
              <TextBlock x:Name="EmptyVideoLibrary" Text="Your clips will appear here." Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
              <ListBox x:Name="VideoGallery" Height="124" Margin="0,10,0,0" SelectionChanged="VideoSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Recent videos"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="140" ToolTip="{Binding Path}"><Border Background="{StaticResource ElevatedBrush}" CornerRadius="8" Height="65"><Grid><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/><Border Background="#80000000" CornerRadius="12" Width="24" Height="24"><TextBlock Text="▶" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border></Grid></Border><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,7,0,0"/><TextBlock Text="{Binding Details}" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="ReferencesTab" Style="{StaticResource NavigationTabStyle}" AutomationProperties.Name="References" Tag="Keep subjects and visual style consistent across your work.">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B9;" Margin="0,0,9,0"/><TextBlock Text="References"/></StackPanel></TabItem.Header>
        <Grid x:Name="ReferencesPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Reference library" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Keep faces, places, and visual style consistent across your images." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="ReferenceCount" Text="0 / 10 images" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/></Grid>
          <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><WrapPanel><Button x:Name="AddReferencesButton" Content="+  Add images" Style="{StaticResource PrimaryButton}" Click="AddReferences" Margin="0,0,10,0"/><Button Content="Load set…" Click="LoadReferenceSet" Margin="0,0,10,0"/><Button Content="Save set…" Click="SaveReferenceSet"/></WrapPanel><TextBlock Grid.Column="1" Text="Edit uses image 1 as the canvas.&#x0a;Create uses references in a new composition." Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid>
          <Grid Grid.Row="2">
            <Border x:Name="ReferencesEmpty" Style="{StaticResource PanelBorder}" Padding="40"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B9;" FontSize="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/><TextBlock Text="Build a visual starting point" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Add portraits, locations, or artwork you want to draw from. Give each image a role and note the details to keep." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,12,0,0" LineHeight="23"/></StackPanel></Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReferenceList"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="4"><Image Source="{Binding Thumbnail}" Width="102" Height="100" Stretch="Uniform"/></Border><TextBlock Text="{Binding Label}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontFamily="Consolas" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
                <Grid Grid.Column="1" Margin="22,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/><ComboBox Grid.Row="1" SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,10,0,10" MaxWidth="280" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Reference role"><ComboBoxItem Content="General reference"/><ComboBoxItem Content="Character identity"/><ComboBoxItem Content="Outfit or equipment"/><ComboBoxItem Content="Location"/><ComboBoxItem Content="Art style"/><ComboBoxItem Content="Composition"/></ComboBox><TextBox Grid.Row="2" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" SpellCheck.IsEnabled="True" Language="en-US" TextWrapping="Wrap" MinHeight="45" ToolTip="Describe the face, outfit, palette, or other details to keep." AutomationProperties.Name="Reference details"/></Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="Move up" Style="{StaticResource SubtleButton}" Click="MoveReferenceUp" Margin="0,0,0,5"/><Button Content="Move down" Style="{StaticResource SubtleButton}" Click="MoveReferenceDown" Margin="0,0,0,5"/><Button Content="Remove" Style="{StaticResource SubtleButton}" Click="RemoveReference" Foreground="#B4233A"/></StackPanel>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Use references →" Style="{StaticResource PrimaryButton}" Click="UseReferences"/><TextBlock Text="Start with the few images that best define your result. More references use more memory." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12" Margin="0,0,24,0"/></DockPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="BuilderTab" Style="{StaticResource NavigationTabStyle}" AutomationProperties.Name="Prompt Builder" Tag="Turn a starting idea into a clear creative direction.">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" Margin="0,0,9,0"/><TextBlock Text="Prompt Builder"/></StackPanel></TabItem.Header>
        <Grid x:Name="BuilderPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelBorder}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20"><TextBlock Text="Start with an idea" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="BuilderIntro" Text="Set the subject, look, and details that matter." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
              <Label Content="Create a prompt for" Target="{Binding ElementName=BuilderMediaType}" Margin="0,12,0,0"/><ComboBox x:Name="BuilderMediaType" SelectedIndex="0" SelectionChanged="BuilderMediaChanged" AutomationProperties.Name="Prompt media type"><ComboBoxItem Content="Image"/><ComboBoxItem Content="Video"/></ComboBox>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
              <StackPanel x:Name="BuilderArtworkFields"><Label Content="Artwork type" Target="{Binding ElementName=ArtworkType}"/><ComboBox x:Name="ArtworkType" SelectedIndex="0" Margin="0,0,0,18"><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Backdrop"/><ComboBoxItem Content="Handout"/><ComboBoxItem Content="Transparent token"/><ComboBoxItem Content="Other artwork"/></ComboBox></StackPanel>
              <Label Content="Subject and action" Target="{Binding ElementName=BuilderSubject}"/><TextBox x:Name="BuilderSubject" TextWrapping="Wrap" AcceptsReturn="True" Height="88" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Subject and action" Margin="0,0,0,18"/>
              <Label Content="Setting and important details" Target="{Binding ElementName=BuilderSetting}"/><TextBox x:Name="BuilderSetting" TextWrapping="Wrap" AcceptsReturn="True" Height="72" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Setting and details" Margin="0,0,0,22"/>
              <StackPanel x:Name="BuilderVideoFields" Visibility="Collapsed">
                <TextBlock Text="Movement and sound" Style="{StaticResource SectionLabel}" Margin="0,0,0,14"/>
                <Label Content="Subject and scene movement" Target="{Binding ElementName=BuilderMotion}"/><TextBox x:Name="BuilderMotion" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Subject and scene movement"/><TextBlock Text="For example: the fox turns its head; leaves move in the breeze." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/>
                <Label Content="Camera movement" Target="{Binding ElementName=BuilderCamera}"/><TextBox x:Name="BuilderCamera" TextWrapping="Wrap" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Camera movement"/><TextBlock Text="For example: locked camera, slow push-in, or a gentle pan." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/>
                <Label Content="Timing and pacing" Target="{Binding ElementName=BuilderPacing}"/><TextBox x:Name="BuilderPacing" TextWrapping="Wrap" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Timing and pacing"/><TextBlock Text="Describe the order of events. Set the clip's duration in Videos." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/>
                <Label Content="Sound and dialogue" Target="{Binding ElementName=BuilderAudio}"/><TextBox x:Name="BuilderAudio" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Sound and dialogue"/><TextBlock Text="For example: soft rain, quiet footsteps, no music or speech." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,22"/>
              </StackPanel>
              <TextBlock Text="Look and feel" Style="{StaticResource SectionLabel}" Margin="0,0,0,14"/>
              <Label Content="Art style" Target="{Binding ElementName=BuilderStyle}"/><TextBox x:Name="BuilderStyle" TextWrapping="Wrap" AcceptsReturn="True" Height="72" SpellCheck.IsEnabled="True" Language="en-US" AutomationProperties.Name="Campaign art style"/><TextBlock Text="Saved with your reference sets for a consistent look." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18"/>
              <Label Content="Composition and framing" Target="{Binding ElementName=BuilderComposition}"/><TextBox x:Name="BuilderComposition" SpellCheck.IsEnabled="True" Language="en-US" TextWrapping="Wrap" AutomationProperties.Name="Composition and framing" Margin="0,0,0,18"/>
              <Label Content="Lighting and mood" Target="{Binding ElementName=BuilderLighting}"/><TextBox x:Name="BuilderLighting" SpellCheck.IsEnabled="True" Language="en-US" TextWrapping="Wrap" AutomationProperties.Name="Lighting and mood" Margin="0,0,0,18"/>
              <Label Content="Exact lettering, if any" Target="{Binding ElementName=BuilderLettering}"/><TextBox x:Name="BuilderLettering" SpellCheck.IsEnabled="True" Language="en-US" TextWrapping="Wrap" AutomationProperties.Name="Exact lettering" Margin="0,0,0,18"/>
              <Label x:Name="BuilderPreserveLabel" Content="For edits: what should stay unchanged?" Target="{Binding ElementName=BuilderPreserve}"/><TextBox x:Name="BuilderPreserve" SpellCheck.IsEnabled="True" Language="en-US" TextWrapping="Wrap" AutomationProperties.Name="Details to preserve"/>
            </StackPanel></ScrollViewer>
            <Button Grid.Row="2" Content="Build prompt →" Click="BuildPrompt" MinHeight="42" Margin="0,20,0,0"/>
          </Grid></Border>
          <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your prompt" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="BuilderOutputHint" Text="Edit freely. Refine when you're ready." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Copy" Click="CopyBuiltPrompt" Style="{StaticResource SubtleButton}" VerticalAlignment="Top"/></Grid>
            <TextBox x:Name="BuiltPrompt" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" SpellCheck.IsEnabled="True" Language="en-US" FontSize="14" Padding="16" AutomationProperties.Name="Built prompt"/>
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
              <StackPanel x:Name="ImageRefinementControls"><WrapPanel><Button Content="Refine with local AI" Click="RefinePrompt" Margin="0,0,10,10"/><Button x:Name="UndoRefinementButton" Content="Undo" ToolTip="Undo refinement" Click="UndoRefinement" IsEnabled="False" Style="{StaticResource SubtleButton}" Margin="0,0,0,10"/></WrapPanel>
              <CheckBox x:Name="RefineWithReferences" Content="Include my reference images" IsChecked="True" Margin="0,0,0,10"/></StackPanel>
              <TextBlock x:Name="RewriteInfo" Text="AI refinement runs on your computer. Review its changes before generating." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,18"/>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel>
                <WrapPanel x:Name="ImagePromptActions"><Button Content="Use for new image →" Style="{StaticResource PrimaryButton}" Click="UseBuiltPromptCreate" Margin="0,0,10,8"/><Button Content="Use for edit" Click="UseBuiltPromptEdit" Margin="0,0,0,8"/></WrapPanel>
                <WrapPanel x:Name="VideoPromptActions" Visibility="Collapsed"><Button Content="Use for text-to-video →" Style="{StaticResource PrimaryButton}" Click="UseBuiltPromptVideoText" Margin="0,0,10,8"/><Button Content="Use for image-to-video →" Click="UseBuiltPromptVideoImage" Margin="0,0,0,8"/></WrapPanel>
              </StackPanel></Border>
            </StackPanel>
          </Grid></Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="ModelsTab" Style="{StaticResource NavigationTabStyle}" AutomationProperties.Name="Models &amp; LoRAs" Tag="See what is installed and ready to create.">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" Margin="0,0,12,0"/><TextBlock Text="Models &amp; LoRAs"/></StackPanel></TabItem.Header>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,22"><WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><Button x:Name="DownloadModelsButton" Content="Download models…" Click="OpenModelSetup" Visibility="Collapsed" Margin="0,0,10,0"/><Button Content="LoRA folder ↗" Click="OpenLoraFolder" Margin="0,0,10,0"/><Button x:Name="RefreshModelsButton" Content="Refresh library" Click="RefreshModels" Style="{StaticResource PrimaryButton}"/></WrapPanel><StackPanel><TextBlock Text="Installed models" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ModelsSummary" Text="Reading your local library…" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <ItemsControl x:Name="ModelList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" Margin="0,7,12,12"/><TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/></StackPanel>
              <Button Grid.Column="1" Content="Use model →" Click="UseCatalogModel" IsEnabled="{Binding Ready}" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Style="{StaticResource PanelBorder}" Margin="0,12,8,0"><StackPanel><TextBlock Text="LoRA library" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Add optional LoRAs inside a workflow. Each workflow remembers its model, LoRAs, strength, and enabled state." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18"/><ItemsControl x:Name="LoraLibrary"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,10"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
      <DockPanel><Button x:Name="CancelButton" Content="Cancel generation" DockPanel.Dock="Right" Click="CancelGeneration" Visibility="Collapsed" Margin="16,0,0,0" Padding="12,5" MinHeight="30"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="Local workspace" Foreground="{StaticResource MutedBrush}" FontSize="10" FontFamily="Consolas"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="{StaticResource MutedBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></DockPanel>
    </Border>
  </Grid>
</Window>
