<UserControl x:Class="ImageStudio.LoraPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <DockPanel Margin="0,0,0,8"><Button Content="+ Add" Click="Add" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="8,3" MinHeight="26" AutomationProperties.Name="Add LoRA"/><TextBlock Text="LoRAs" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="Empty" Text="None · Use the model on its own" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
    <ItemsControl x:Name="Rows"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
        <StackPanel>
          <DockPanel><Button Content="×" Click="Remove" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6,0" MinHeight="24" ToolTip="Remove this LoRA" AutomationProperties.Name="Remove LoRA"/><CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Checked="Changed" Unchecked="Changed"/></DockPanel>
          <ComboBox ItemsSource="{Binding Available}" SelectedItem="{Binding Name, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Changed" ToolTip="{Binding Name}" AutomationProperties.Name="LoRA model" Margin="0,8,0,8"/>
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=StrengthSlider, StringFormat=F2}" Width="32" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Strength" Foreground="{DynamicResource MutedBrush}" FontSize="11" Width="65"/><Slider x:Name="StrengthSlider" Minimum="-2" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Strength, UpdateSourceTrigger=PropertyChanged}" ValueChanged="Changed" AutomationProperties.Name="LoRA strength"/></DockPanel>
        </StackPanel>
      </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Use LoRAs trained for the selected model." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
  </StackPanel>
</UserControl>
