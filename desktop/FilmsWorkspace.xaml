<UserControl x:Class="ImageStudio.FilmsWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="560">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><ComboBox x:Name="Projects" Width="180" DisplayMemberPath="Title" SelectionChanged="OpenProject" AutomationProperties.Name="Film project"/><Button Content="New film" Click="NewProject" Margin="8,0"/><Button Content="Reload" Click="ReloadProject"/><Button Content="Collect…" Click="CollectProject" Margin="6,0"/><Button Content="Import collected…" Click="ImportCollection"/><TextBox x:Name="NewTitle" Width="170" Text="Untitled film" Margin="8,0" AutomationProperties.Name="New film title"/></WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorGap" Width="0"/><ColumnDefinition x:Name="InspectorColumn" Width="0"/></Grid.ColumnDefinitions>
      <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="+ Shot" Click="AddShot" Padding="8,5"/><Button Content="Duplicate" Click="DuplicateShot" Padding="8,5"/></WrapPanel>
        <WrapPanel DockPanel.Dock="Bottom"><Button Content="↑" Click="ShotUp" AutomationProperties.Name="Move shot up"/><Button Content="↓" Click="ShotDown" AutomationProperties.Name="Move shot down"/><Button Content="+ Scene" Click="AddScene" Padding="8,5"/></WrapPanel>
        <ListBox x:Name="Shots" DisplayMemberPath="Label" SelectionChanged="SelectShot" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Film shots"/>
      </DockPanel>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="Stages" SelectionChanged="StageChanged" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
          <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Frame" Background="{DynamicResource ElevatedBrush}" Padding="{TemplateBinding Padding}" Margin="1"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
          <TabItem Header="Plan"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
            <TextBlock Text="Film direction" FontSize="20" FontWeight="SemiBold"/><Label Content="Film title"/><TextBox x:Name="FilmTitle" AutomationProperties.Name="Film title"/><Label Content="Brief"/><TextBox x:Name="Brief" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" AutomationProperties.Name="Film brief"/>
            <Label Content="Accepted decisions (one per line; source in authority record)"/><TextBox x:Name="Decisions" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="Accepted film decisions"/><Label Content="Unresolved direction (one per line)"/><TextBox x:Name="Unresolved" AcceptsReturn="True" MinHeight="50" AutomationProperties.Name="Unresolved film direction"/><Button Content="Save film direction" Click="SavePlan" HorizontalAlignment="Left" Margin="0,8"/>
            <Button Content="Record production authority…" Click="RecordAuthority" HorizontalAlignment="Left" Margin="0,6"/><ContentControl x:Name="PlanInspectorHost"><StackPanel x:Name="ShotEditor"><Separator/><TextBlock Text="Selected shot" FontSize="20" FontWeight="SemiBold" Margin="0,10"/><Label Content="Shot name"/><TextBox x:Name="ShotName" AutomationProperties.Name="Shot name"/>
            <Label Content="Scene"/><ComboBox x:Name="SceneBox" DisplayMemberPath="Title" SelectedValuePath="Id" AutomationProperties.Name="Shot scene"/>
            <Label Content="Purpose"/><TextBox x:Name="Purpose" AutomationProperties.Name="Shot purpose"/><Label Content="Action / staging"/><TextBox x:Name="ActionText" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="Shot action"/><Label Content="Camera"/><TextBox x:Name="CameraText" AutomationProperties.Name="Shot camera"/><Label Content="Start state"/><TextBox x:Name="StartState" AutomationProperties.Name="Shot start state"/><Label Content="End state"/><TextBox x:Name="EndState" AutomationProperties.Name="Shot end state"/>
            <Label Content="Dialogue (intended words)"/><TextBox x:Name="Dialogue" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="Intended dialogue"/><Label Content="Generation prompt"/><TextBox x:Name="ShotPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" AutomationProperties.Name="Shot generation prompt"/>
            <WrapPanel><StackPanel><Label Content="Edit frames"/><TextBox x:Name="EditFrames" Width="100" Text="120" AutomationProperties.Name="Shot edit frames"/></StackPanel><StackPanel Margin="12,0"><Label Content="Generation frames"/><TextBox x:Name="GenerationFrames" Width="100" Text="124" AutomationProperties.Name="Shot generation frames"/></StackPanel><StackPanel><Label Content="Mode"/><ComboBox x:Name="GenerationMode" Width="150" SelectedIndex="0" AutomationProperties.Name="Shot generation mode"><ComboBoxItem Content="text"/><ComboBoxItem Content="first-frame"/><ComboBoxItem Content="last-frame"/><ComboBoxItem Content="first-last-frame"/><ComboBoxItem Content="continue"/><ComboBoxItem Content="voice"/><ComboBoxItem Content="control"/></ComboBox></StackPanel></WrapPanel>
            <TextBlock Text="Only verified graph inputs condition generation. Stored continuity references are not automatically connected." Foreground="{DynamicResource WarningBrush}" Margin="0,10"/><Button Content="Save shot" Click="SaveShot" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/></StackPanel></ContentControl>
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="References"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Managed continuity assets" FontSize="20"/><TextBlock Text="Imports copy and verify media plus sidecars. Standalone originals can then be recycled safely." Foreground="{DynamicResource MutedBrush}" Margin="0,8"/><WrapPanel><ComboBox x:Name="AssetRole" Width="150" SelectedIndex="0" AutomationProperties.Name="Film asset role"><ComboBoxItem Content="identity"/><ComboBoxItem Content="wardrobe"/><ComboBoxItem Content="place"/><ComboBoxItem Content="prop"/><ComboBoxItem Content="composition"/><ComboBoxItem Content="keyframe"/><ComboBoxItem Content="last-frame"/><ComboBoxItem Content="take"/><ComboBoxItem Content="dialogue"/><ComboBoxItem Content="music"/><ComboBoxItem Content="effects"/></ComboBox><Button Content="Import and attach…" Click="ImportAsset" Margin="8,0"/></WrapPanel><ListBox x:Name="Assets" DisplayMemberPath="Label" MinHeight="160" Margin="0,12" SelectionChanged="AssetSelected" AutomationProperties.Name="Film assets"/><WrapPanel Margin="0,8"><TextBox x:Name="Precedence" Width="70" Text="0" AutomationProperties.Name="Reference precedence"/><Button Content="Bind selected role / precedence to shot" Click="BindAsset" Margin="8,0"/></WrapPanel><Button Content="Audition / preview selected" Click="PreviewAsset" HorizontalAlignment="Left"/><TextBlock x:Name="AssetDetails" Margin="0,10" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Storyboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Storyboard and animatic" FontSize="20"/><Image x:Name="Keyframe" MaxHeight="300" Stretch="Uniform" Margin="0,12"/><TextBlock x:Name="StoryboardStatus"/><WrapPanel Margin="0,12"><Button Content="Create keyframe →" Click="CreateKeyframe" Margin="0,0,8,0"/><Button Content="Attach keyframe…" Click="ImportKeyframe"/><Button Content="Render animatic" Click="RenderAnimatic" Margin="8,0"/></WrapPanel><TextBlock Text="Animatics use held keyframes and explicitly placed audio cues. Missing pictures are draft placeholders. Motion and finishing need a reviewed connected pilot." Foreground="{DynamicResource MutedBrush}"/><Label Content="Reviewer"/><TextBox x:Name="Reviewer" Text="Paul" AutomationProperties.Name="Animatic reviewer"/><Label Content="Observed finding"/><TextBox x:Name="AnimaticFinding" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" AutomationProperties.Name="Animatic finding"/><Button Content="Approve this animatic revision" Click="ApproveAnimatic" Margin="0,10" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Takes"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Selected performance and source range" FontSize="20"/><TextBlock Text="Imported takes remain unverified until reviewed. Selection records a reason and current shot inputs." Foreground="{DynamicResource MutedBrush}" Margin="0,10"/><Button Content="Import take…" Click="ImportTake" HorizontalAlignment="Left"/><ComboBox x:Name="TakeBox" DisplayMemberPath="Label" Margin="0,10" AutomationProperties.Name="Film take"/><ComboBox x:Name="CompareTake" DisplayMemberPath="Label" AutomationProperties.Name="Comparison take B"/><WrapPanel Margin="0,8"><Button Content="Compare selected takes" Click="CompareTakes"/><Button Content="Close comparison" Click="CloseComparison" Margin="8,0"/></WrapPanel><WrapPanel><StackPanel><Label Content="Source in frame"/><TextBox x:Name="TakeIn" Text="0" Width="120" AutomationProperties.Name="Take source in"/></StackPanel><StackPanel Margin="12,0"><Label Content="Source out frame"/><TextBox x:Name="TakeOut" Text="120" Width="120" AutomationProperties.Name="Take source out"/></StackPanel></WrapPanel><Label Content="Selection reason"/><TextBox x:Name="TakeReason" MinHeight="60" TextWrapping="Wrap" AutomationProperties.Name="Take selection reason"/><WrapPanel Margin="0,10"><Button Content="Select take and range" Click="SelectTake"/><Button Content="Add selected range to edit" Click="AddTakeToEdit" Margin="8,0"/></WrapPanel><Separator Margin="0,12"/><TextBlock Text="Bounded production pilot" FontSize="19"/><ComboBox x:Name="FilmModel" Margin="0,8" AutomationProperties.Name="Film generation model"/><Label Content="Seed (blank for a new candidate)"/><TextBox x:Name="FilmSeed" AutomationProperties.Name="Film candidate seed"/><ComboBox x:Name="FilmProfile" SelectedIndex="0" AutomationProperties.Name="Film sampling profile"><ComboBoxItem Content="pika-flex"/><ComboBoxItem Content="standard"/></ComboBox><WrapPanel Margin="0,8"><Button Content="Prepare preview item" Click="PreparePreview"/><Button Content="Authorize exact pilot item" Click="AuthorizeItem" Margin="8,0"/><Button Content="Enqueue authorized item" Click="EnqueueItem"/></WrapPanel><TextBox x:Name="Proposal" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Executed graph proposal"/><ListBox x:Name="QueueItems" DisplayMemberPath="Label" MinHeight="100" Margin="0,8" AutomationProperties.Name="Durable film queue"/><Label Content="Finding for explicit current-context rebind"/><TextBox x:Name="RebindFinding" AutomationProperties.Name="Current context revalidation finding"/><Button Content="Revalidate selected bytes in current authority" Click="RebindTake" HorizontalAlignment="Left" Margin="0,8"/><Button Content="Cancel selected owned item" Click="CancelItem" HorizontalAlignment="Left" Margin="0,8"/><Button Content="Prepare selected preview finish" Click="PrepareFinish" Margin="0,8" HorizontalAlignment="Left"/><Button Content="Adopt selected completed take" Click="AdoptCompleted" HorizontalAlignment="Left"/><TextBlock x:Name="Capabilities" Foreground="{DynamicResource WarningBrush}" Margin="0,12"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Edit"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Picture / dialogue / music / effects" FontSize="20"/><WrapPanel Margin="0,10"><Button Content="Undo" Click="Undo"/><Button Content="Redo" Click="Redo" Margin="8,0"/><Button Content="Render draft cut" Click="RenderDraft"/><Button Content="Cancel draft render" Click="CancelDraft" Margin="8,0"/></WrapPanel><ListBox x:Name="Timeline" MinHeight="130" DisplayMemberPath="Label" SelectionChanged="SelectSegment" AutomationProperties.Name="Picture timeline"/><Button Content="Load selected filmstrip / waveform" Click="InspectTimelineMedia" HorizontalAlignment="Left" Margin="0,8"/><Image x:Name="Filmstrip" MaxHeight="68" Stretch="Uniform"/><Image x:Name="Waveform" MaxHeight="100" Stretch="Uniform"/><WrapPanel Margin="0,8"><Button Content="↑" Click="SegmentUp" AutomationProperties.Name="Move picture earlier"/><Button Content="↓" Click="SegmentDown" AutomationProperties.Name="Move picture later"/><Button Content="Split" Click="SplitSegment"/><Button Content="Ripple remove" Click="RemoveSegment"/><Button Content="Leave gap" Click="GapSegment"/></WrapPanel><WrapPanel><StackPanel><Label Content="Source in"/><TextBox x:Name="TrimIn" Width="90" Text="0" AutomationProperties.Name="Timeline source in"/></StackPanel><StackPanel Margin="8,0"><Label Content="Source out"/><TextBox x:Name="TrimOut" Width="90" Text="120" AutomationProperties.Name="Timeline source out"/></StackPanel><StackPanel><Label Content="Split at"/><TextBox x:Name="SplitFrame" Width="90" Text="60" AutomationProperties.Name="Split source frame"/></StackPanel></WrapPanel><WrapPanel><StackPanel><Label Content="Fade in frames"/><TextBox x:Name="FadeIn" Width="100" Text="0" AutomationProperties.Name="Picture fade in"/></StackPanel><StackPanel Margin="8,0"><Label Content="Fade out frames"/><TextBox x:Name="FadeOut" Width="100" Text="0" AutomationProperties.Name="Picture fade out"/></StackPanel><Button Content="Apply trim / fades" Click="TrimSegment" VerticalAlignment="Bottom"/></WrapPanel>
            <Separator Margin="0,14"/><TextBlock Text="Independent audio cue" FontSize="17"/><ComboBox x:Name="AudioAsset" DisplayMemberPath="Label" Margin="0,8" AutomationProperties.Name="Audio cue source"/><ComboBox x:Name="AudioTrack" SelectedIndex="0" AutomationProperties.Name="Audio track"><ComboBoxItem Content="dialogue"/><ComboBoxItem Content="music"/><ComboBoxItem Content="effects"/></ComboBox><WrapPanel><StackPanel><Label Content="Start sample (48 kHz)"/><TextBox x:Name="CueStart" Text="0" Width="140" AutomationProperties.Name="Audio timeline sample"/></StackPanel><StackPanel Margin="8,0"><Label Content="Source in sample"/><TextBox x:Name="CueIn" Text="0" Width="120" AutomationProperties.Name="Audio source sample"/></StackPanel><StackPanel><Label Content="Samples"/><TextBox x:Name="CueSamples" Text="48000" Width="120" AutomationProperties.Name="Audio cue length"/></StackPanel></WrapPanel><WrapPanel><StackPanel><Label Content="Volume 0–8"/><TextBox x:Name="CueVolume" Text="1" Width="90" AutomationProperties.Name="Audio cue volume"/></StackPanel><CheckBox x:Name="CueMute" Content="Mute" Margin="10,28,10,0"/><Button Content="Add cue" Click="AddAudio" VerticalAlignment="Bottom"/></WrapPanel><WrapPanel Margin="0,8"><StackPanel><Label Content="Fade in samples"/><TextBox x:Name="AudioFadeIn" Width="120" Text="0" AutomationProperties.Name="Audio fade in samples"/></StackPanel><StackPanel Margin="8,0"><Label Content="Fade out samples"/><TextBox x:Name="AudioFadeOut" Width="120" Text="0" AutomationProperties.Name="Audio fade out samples"/></StackPanel></WrapPanel><WrapPanel><Button Content="Update selected cue" Click="UpdateAudioCue"/><Button Content="Remove selected cue" Click="RemoveAudioCue" Margin="8,0"/></WrapPanel><ListBox SelectionChanged="SelectAudioCue" x:Name="AudioCues" DisplayMemberPath="Label" MinHeight="85" Margin="0,8" AutomationProperties.Name="Audio timeline"/>
            <Label Content="Title / marker text"/><TextBox x:Name="TitleText" AutomationProperties.Name="Title text"/><WrapPanel Margin="0,8"><Button Content="Add title over selected frames" Click="AddTitle"/><Button Content="Add marker at split frame" Click="AddMarker" Margin="8,0"/></WrapPanel><ListBox x:Name="Markers" DisplayMemberPath="Label" MinHeight="50" AutomationProperties.Name="Timeline markers"/><Separator Margin="0,12"/><TextBlock Text="Repair one short section" FontSize="19"/><WrapPanel><ComboBox x:Name="RepairKind" SelectedIndex="0" Width="120" AutomationProperties.Name="Repair operation"><ComboBoxItem Content="Retake"/><ComboBoxItem Content="Extend"/><ComboBoxItem Content="Bridge"/><ComboBoxItem Content="Fill"/></ComboBox><ComboBox x:Name="RepairModality" SelectedIndex="0" Width="120" Margin="8,0" AutomationProperties.Name="Repair modality"><ComboBoxItem Content="both"/><ComboBoxItem Content="picture"/><ComboBoxItem Content="audio"/></ComboBox><ComboBox x:Name="RepairPhase" SelectedIndex="0" Width="120" AutomationProperties.Name="Repair admission phase"><ComboBoxItem Content="pilot"/><ComboBoxItem Content="repair"/></ComboBox></WrapPanel><Label Content="Stable defect ID"/><TextBox x:Name="RepairDefect" AutomationProperties.Name="Repair defect ID"/><WrapPanel Margin="0,8"><TextBox x:Name="RepairBudget" Width="80" Text="2" AutomationProperties.Name="Total defect repair budget"/><Button Content="Assign total sourced repair budget" Click="SetRepairBudget" Margin="8,0"/></WrapPanel><Label Content="New edit frames (Extend; other operations use selected interval)"/><TextBox x:Name="RepairFrames" Text="120" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Repair edit frames"/><Label Content="Repair prompt"/><TextBox x:Name="RepairPrompt" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" AutomationProperties.Name="Repair prompt"/><WrapPanel Margin="0,8"><Button Content="Prepare exact repair anchors / graph" Click="PrepareRepair"/><Button Content="Place selected completed repair" Click="PlaceRepair" Margin="8,0"/></WrapPanel><TextBlock Text="Repair conditioning and seams remain unverified until inspected in motion and sound. Pilot trials require explicit allowlisting; production repair requires a current approved pilot and sourced total defect budget." Foreground="{DynamicResource WarningBrush}"/>
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Review"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Review exact encoded bytes" FontSize="20"/><ListBox x:Name="Cuts" DisplayMemberPath="Label" SelectionChanged="CutSelected" MinHeight="100" Margin="0,10" AutomationProperties.Name="Review cuts"/><TextBlock x:Name="CutDetails"/><Button Content="Promote current draft to intended final" Click="PromoteCut" HorizontalAlignment="Left" Margin="0,10"/><TextBlock Text="Draft cuts never issue delivery receipts. Required visual, motion, speech and listening evidence stays unverified until independently inspected and recorded." Foreground="{DynamicResource WarningBrush}" Margin="0,10"/><ComboBox x:Name="ReviewPurpose" SelectedIndex="0" AutomationProperties.Name="Review purpose"><ComboBoxItem Content="final"/><ComboBoxItem Content="pilot"/></ComboBox><Button Content="Use current cut as connected motion pilot" Click="PilotCandidate" Margin="0,8" HorizontalAlignment="Left"/><WrapPanel Margin="0,12"><Button Content="Load current artifact review" Click="LoadReview"/><Button Content="Export approved film…" Click="DeliverFilm" Margin="8,0"/></WrapPanel><ComboBox x:Name="ReviewCheck" DisplayMemberPath="Label" SelectionChanged="SelectReviewCheck" AutomationProperties.Name="Required review criterion"/><WrapPanel Margin="0,8"><Button Content="Frame before cut" Click="CutBefore"/><Button Content="Frame after cut" Click="CutAfter" Margin="8,0"/></WrapPanel><Label Content="Reviewer / capability"/><TextBox x:Name="ReviewPerson" Text="Paul" AutomationProperties.Name="Final reviewer"/><Label Content="Observed finding"/><TextBox x:Name="ReviewFinding" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" AutomationProperties.Name="Observed review finding"/><Label Content="Inspection method"/><TextBox x:Name="ReviewMethod" AutomationProperties.Name="Review inspection method"/><Label Content="Modalities actually inspected (select each that applies)"/><ListBox x:Name="ReviewModalities" SelectionMode="Multiple" MinHeight="70" AutomationProperties.Name="Inspected modalities"/><Label Content="Intended staging at cut (when applicable)"/><TextBox x:Name="ReviewStaging" AutomationProperties.Name="Cut staging"/><ComboBox x:Name="Judgment" SelectedIndex="0" Margin="0,8" AutomationProperties.Name="Review judgment"><ComboBoxItem Content="unverified"/><ComboBoxItem Content="failed"/><ComboBoxItem Content="passed"/></ComboBox><Button Content="Record this judgment with exact artifact evidence" Click="RecordJudgment" HorizontalAlignment="Left" Margin="0,8"/><Separator Margin="0,12"/><TextBlock Text="Independent observed transcript" FontSize="18"/><TextBlock Text="Enter words actually heard or independently recognized. Never copy intended dialogue as observed speech. Intervals use decoded stereo audio at 48 kHz." Foreground="{DynamicResource MutedBrush}" Margin="0,8"/><ComboBox x:Name="TranscriptAudio" DisplayMemberPath="Label" AutomationProperties.Name="Transcript source audio"/><TextBox x:Name="ObservedWords" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,8" AutomationProperties.Name="Independently observed words"/><Label Content="Recognizer/version or manual listening method"/><TextBox x:Name="TranscriptMethod" AutomationProperties.Name="Transcript observation method"/><WrapPanel><StackPanel><Label Content="Start sample"/><TextBox x:Name="TranscriptStart" Text="0" Width="120" AutomationProperties.Name="Transcript interval start"/></StackPanel><StackPanel Margin="8,0"><Label Content="End sample"/><TextBox x:Name="TranscriptEnd" Text="48000" Width="120" AutomationProperties.Name="Transcript interval end"/></StackPanel></WrapPanel><ComboBox x:Name="TranscriptStatus" SelectedIndex="0" Margin="0,8" AutomationProperties.Name="Transcript evidence status"><ComboBoxItem Content="unverified"/><ComboBoxItem Content="observed"/><ComboBoxItem Content="failed"/></ComboBox><Button Content="Save transcript bound to decoded audio hash" Click="ImportTranscript" HorizontalAlignment="Left"/><TextBox x:Name="ReviewDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Required film review checks"/></StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><MediaElement x:Name="Player" ScrubbingEnabled="True" Grid.ColumnSpan="2" LoadedBehavior="Manual" UnloadedBehavior="Close" Height="150" Visibility="Collapsed"/><MediaElement x:Name="ComparePlayer" ScrubbingEnabled="True" Grid.Column="1" LoadedBehavior="Manual" UnloadedBehavior="Close" Height="150" Visibility="Collapsed"/></Grid><Slider x:Name="FilmSeek" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SeekFilm" AutomationProperties.Name="Film frame seek"/><TextBlock x:Name="Playhead" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><WrapPanel><Button Content="Play" Click="Play"/><Button Content="Pause" Click="PausePlayer" Margin="8,0"/><Button Content="Stop" Click="StopPlayer"/></WrapPanel></StackPanel>
      </Grid>
      <Border x:Name="InspectorBorder" Grid.Column="4" Visibility="Collapsed" Style="{StaticResource PanelBorder}" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="WideInspectorHost"/></ScrollViewer></Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource ElevatedBrush}" Padding="10" Margin="0,10,0,0"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Pause queue" Click="PauseQueue"/><Button Content="Resume queue" Click="ResumeQueue" Margin="6,0"/><Button Content="Reconcile one" Click="DriveOne"/></WrapPanel><TextBlock x:Name="Status" Text="Create a film to start planning. Imported media and drafts require no GPU." VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
  </Grid>
</UserControl>
