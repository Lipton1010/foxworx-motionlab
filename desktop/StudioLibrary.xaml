<UserControl x:Class="ImageStudio.StudioLibrary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button Content="Refresh" Click="RefreshLibrary" DockPanel.Dock="Right"/><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Search output library" ToolTip="Search output filenames"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="Files" SelectionChanged="Selected" DisplayMemberPath="Name" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Output library"/><TextBox Grid.Column="1" x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="12,0,0,0" AutomationProperties.Name="Media provenance"/></Grid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0"><WrapPanel><ComboBox x:Name="Role" SelectedIndex="0" Width="150" AutomationProperties.Name="Adopt media as"><ComboBoxItem Content="keyframe"/><ComboBoxItem Content="take"/><ComboBoxItem Content="identity"/><ComboBoxItem Content="place"/></ComboBox><Button Content="Add to open film / selected shot" Click="Adopt" Margin="8,0"/></WrapPanel><TextBlock x:Name="Status" Text="Open a film and select its shot before adopting media. Managed film storage is excluded here." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
  </Grid>
</UserControl>
