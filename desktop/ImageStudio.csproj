<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Image Studio</AssemblyName>
    <RootNamespace>ImageStudio</RootNamespace>
    <Version>2.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ImageStudio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ImageStudio.ico" />
    <Resource Include="Assets\ImageStudio.png" />
    <EmbeddedResource Include="Workflows\*.json" />
  </ItemGroup>
</Project>
